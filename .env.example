# Copy to .env at the repository root (it is never committed). The server and the admin tool
# read it on their own; `--env-file <path>` makes either read another file instead, and a
# variable already set in the real environment wins over the file. For the container pass it
# with `docker run --env-file .env`.

# Required. At least 32 characters, secret. This placeholder is too short on purpose, so an
# unedited copy does not start. Make a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me

# How long a session lasts: the access token in minutes, the sign-in cookie in days.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# The sign-in cookie is only sent over https when this is true. It defaults to true when
# NODE_ENV=production, so set it to false only to serve plain http on a trusted network.
# COOKIE_SECURE=false

# Where the database and its backups live. The container image already sets these to its two
# volumes, /data and /backups; outside a container the defaults are data/pachanguero.db and a
# backups/ folder beside it. Uncomment to put them elsewhere.
# PACHANGUERO_DB=/data/pachanguero.db
# PACHANGUERO_BACKUPS=/backups

# The port and the address to listen on (127.0.0.1 behind a reverse proxy on the same machine).
# PORT=8787
# HOST=0.0.0.0
