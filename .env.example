# Copy to .env at the repository root (it is never committed). The server and the admin tool
# read it on their own; `--env-file <path>` makes either read another file instead, and a
# variable already set in the real environment wins over the file. For the container pass it
# with `docker run --env-file .env`.

# Required. At least 32 characters, secret. This placeholder is too short on purpose, so an
# unedited copy does not start. Make a real one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-me

# How long a session lasts: the access token in minutes, the sign-in cookie in days.
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=30

# The sign-in cookie is only sent over https when this is true. It defaults to true when
# NODE_ENV=production, so set it to false only to serve plain http on a trusted network.
# COOKIE_SECURE=false

# Where the database and its backups live. The container image already sets these to its two
# volumes, /data and /backups; outside a container the defaults are data/pachanguero.db and a
# backups/ folder beside it. Uncomment to put them elsewhere.
# PACHANGUERO_DB=/data/pachanguero.db
# PACHANGUERO_BACKUPS=/backups

# The port and the address to listen on (127.0.0.1 behind a reverse proxy on the same machine).
# PORT=8787
# HOST=0.0.0.0

# The bank access (all optional: without them the app starts, manual payments work, and the
# Banco panel names what is missing).
# The address the browser reaches the app at. The bank sends the browser back to
# <this>/api/bank/callback, which must be registered exactly as an allowed redirect URL of the
# application at the bank's developer side. Absolute https; http://localhost:<port> for development.
# PACHANGUERO_PUBLIC_URL=https://pachanguero.duckdns.org
# The application's id and private key. Make the key and a certificate once with
#   openssl req -x509 -newkey rsa:4096 -nodes -keyout private.key -out public.crt -days 3650 -subj "/CN=pachanguero"
# upload public.crt to the application at the developer side and keep private.key here: the
# whole PEM on one line, with \n for its line breaks.
# ENABLE_BANKING_APP_ID=
# ENABLE_BANKING_PRIVATE_KEY=
# The aggregator's address. Leave it unset: the real host is the default. Only the end-to-end
# tests set it, to reach a fake bank.
# ENABLE_BANKING_API_URL=

# Tests only (`npm run test:sandbox`): the bank's sandbox suite reads a standing session with a
# sandbox application of its own, never the production one above. It is skipped, with a message,
# unless ENABLE_BANKING_SANDBOX=1 and all of these are set.
# ENABLE_BANKING_SANDBOX=1
# ENABLE_BANKING_SANDBOX_APP_ID=
# ENABLE_BANKING_SANDBOX_PRIVATE_KEY=
# ENABLE_BANKING_SANDBOX_SESSION_ID=
# ENABLE_BANKING_SANDBOX_ACCOUNT_UID=
# ENABLE_BANKING_SANDBOX_ACCOUNT_HASH=
# ENABLE_BANKING_SANDBOX_DATE_FROM=2026-01-01
# ENABLE_BANKING_SANDBOX_EXPECTED_COUNT=
