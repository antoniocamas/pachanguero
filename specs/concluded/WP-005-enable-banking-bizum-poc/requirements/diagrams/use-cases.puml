@startuml
left to right direction
actor "Organiser" as org
actor "Enable Banking API" as eb <<system>>
actor "Revolut" as rev <<system>>

rectangle "Enable Banking PoC (standalone script + two guides)" {
  usecase "UC-005-01 Authorise the Revolut account" as UC1
  usecase "UC-005-02 Read the transactions" as UC2
  usecase "UC-005-03 Keep credentials and data local" as UC3
  usecase "UC-005-04 Recognise a Bizum and its sender" as UC4
  usecase "UC-005-05 Report player matches" as UC5
  usecase "UC-005-06 Measure the limits" as UC6
  usecase "UC-005-07 Re-authorise" as UC7
  usecase "UC-005-08 Publish the generic guide" as UC8
  usecase "UC-005-09 Publish the Pachanguero guide" as UC9
}

org --> UC1
org --> UC2
org --> UC4
org --> UC5
org --> UC6
org --> UC7
org --> UC8
org --> UC9
UC1 --> eb
UC1 --> rev
UC2 --> eb
UC7 --> eb
UC7 --> rev
UC2 ..> UC1 : <<include>>
UC4 ..> UC2 : <<include>>
UC5 ..> UC4 : <<include>>
UC6 ..> UC2 : <<include>>
UC7 ..> UC1 : <<include>>
UC1 ..> UC3 : <<include>>
UC2 ..> UC3 : <<include>>
UC8 ..> UC4 : <<include>>
UC9 ..> UC5 : <<include>>
@enduml
