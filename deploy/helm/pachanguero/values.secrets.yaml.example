# Copy to values.secrets.yaml (git-ignored) and fill in.
secrets:
  # node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
  jwtSecret: "replace-me-with-48-random-bytes"

  # The bank access (optional: without it the app starts and the Banco panel says what is missing).
  # Make a key and a certificate once:
  #   openssl req -x509 -newkey rsa:4096 -nodes -keyout private.key -out public.crt -days 3650 -subj "/CN=pachanguero"
  # The certificate goes to the application's page in the Enable Banking Control Panel; the key
  # stays here. `https://pachanguero.duckdns.org/api/bank/callback` must be listed there, exactly,
  # as an allowed redirect URL of the production application.
  enableBankingAppId: "replace-me-with-the-application-id"
  enableBankingPrivateKey: |
    -----BEGIN PRIVATE KEY-----
    replace-me-with-the-key-from-private.key
    -----END PRIVATE KEY-----
